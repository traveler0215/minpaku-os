# Cloudflare Workers secrets (set via `wrangler secret put`)
ADMIN_JWT_SECRET=your-random-secret-here
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_STAFF_CHANNEL_SECRET=your-line-staff-channel-secret
LINE_STAFF_ACCESS_TOKEN=your-line-staff-access-token

# wrangler.toml vars
LIFF_ID=your-liff-id
AGENT_ENDPOINT=http://your-vps-ip:8788

# Admin UI (.env or build arg)
VITE_API_BASE_URL=https://your-worker.workers.dev
