# 管理画面の本番ビルド時に埋め込まれる環境変数
# コピーして .env.production を作成し、実際の値を入れてください:
#   cp .env.production.example .env.production

# Worker の本番 URL（wrangler deploy 後に出力される URL）
VITE_API_BASE_URL=https://your-worker.workers.dev

# LIFF ID（LINE Developers Console で取得）
VITE_LIFF_ID=YOUR_LIFF_ID

# AI 機能（シフト提案 / メッセージ生成 / 売上 CSV 取込）を有効化する場合は true
# VPS の Claude agent エンドポイントを wrangler.toml の AGENT_ENDPOINT にセットしていることが前提
# VITE_AGENT_ENABLED=true
